diff --git a/mtkclient/Library/Hardware/seccfg.py b/mtkclient/Library/Hardware/seccfg.py
index 7763ca1..f230369 100644
--- a/mtkclient/Library/Hardware/seccfg.py
+++ b/mtkclient/Library/Hardware/seccfg.py
@@ -147,6 +147,11 @@ class SecCfgV4(metaclass=LogBase):
             self.lock_state = 1
             if critical:
                 self.dm_verity_state = 0
+        elif lockflag == "clearverity":
+            # Keep the current lock state and clear only the persistent
+            # dm-verity corruption marker. The authenticated hash below is
+            # regenerated using this device's own SEJ hardware key.
+            self.dm_verity_state = 0
         seccfg_data = pack("<IIIIIII", self.magic, self.seccfg_ver, self.seccfg_size, self.lock_state,
                            self.dm_verity_state, self.sboot_runtime, 0x45454545)
         dec_hash = hashlib.sha256(seccfg_data).digest()
